# Copy this file to .env and fill in your values. Never commit .env.
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=kosmikos

# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "production" when serving over HTTPS (makes the session cookie HTTPS-only)
NODE_ENV=development
