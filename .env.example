# Copy this file to .env and fill in your values. Never commit .env.
PORT=5000
# Listen address. Keep 127.0.0.1 behind nginx; use 0.0.0.0 only if your
# hosting platform requires it.
HOST=127.0.0.1
# Which proxies to trust for X-Forwarded-* headers. Leave unset with nginx on
# the same machine. On a hosting platform, set what its docs say (often 1).
# TRUST_PROXY=1

DB_HOST=localhost
DB_PORT=3306
DB_USER=kosmikos_app
DB_PASSWORD=change-me
DB_NAME=kosmikos

# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Log out after this many minutes of inactivity (and always after 7 days)
SESSION_IDLE_MINUTES=120

# Set to "production" ONLY once HTTPS works (DEPLOY.md step 2): the login
# cookie becomes HTTPS-only, so over plain HTTP nobody can stay logged in.
NODE_ENV=development

# Uploads: per-user limit, and refuse uploads when free disk space drops below this
UPLOAD_MAX_PER_HOUR=30
MIN_FREE_DISK_MB=500
